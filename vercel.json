{
  "buildCommand": "yarn build",
  "outputDirectory": "dist",
  "framework": "vite",
  "installCommand": "yarn install",
  "rewrites": [
    {
      "source": "/api/workers-chat",
      "destination": "/api/chat"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/api/og-default",
      "destination": "/api/og?type=default"
    },
    {
      "source": "/api/og-product",
      "destination": "/api/og?type=product"
    },
    {
      "source": "/api/og-category",
      "destination": "/api/og?type=category"
    },
    {
      "source": "/api/og-category-image",
      "destination": "/api/og?type=category-image"
    },
    {
      "source": "/api/img-proxy",
      "destination": "/api/og?type=img-proxy"
    },
    {
      "source": "/api/telegram/notify",
      "destination": "/api/og?type=telegram-notify"
    },
    {
      "source": "/product/:id",
      "destination": "/api/og?type=product&id=:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|WhatsApp|Twitterbot|TelegramBot|LinkedInBot|Slackbot|Discordbot|Applebot|Pinterest|redditbot|Googlebot|Google-InspectionTool|Storebot-Google|AdsBot-Google|Google-Extended|bingbot|BingPreview|YandexBot|YandexImages|DuckDuckBot|Embedly|vkShare|W3C_Validator|Iframely|skypeuripreview|nuzzel|Snapchat|Tumblr|Mediapartners-Google|Baiduspider|SemrushBot|AhrefsBot).*"
        }
      ]
    },
    {
      "source": "/products/:id",
      "destination": "/api/og?type=product&id=:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|WhatsApp|Twitterbot|TelegramBot|LinkedInBot|Slackbot|Discordbot|Applebot|Pinterest|redditbot|Googlebot|Google-InspectionTool|Storebot-Google|AdsBot-Google|Google-Extended|bingbot|BingPreview|YandexBot|YandexImages|DuckDuckBot|Embedly|vkShare|W3C_Validator|Iframely|skypeuripreview|nuzzel|Snapchat|Tumblr|Mediapartners-Google|Baiduspider|SemrushBot|AhrefsBot).*"
        }
      ]
    },
    {
      "source": "/category/:name",
      "destination": "/api/og?type=category&category=:name",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|WhatsApp|Twitterbot|TelegramBot|LinkedInBot|Slackbot|Discordbot|Applebot|Pinterest|redditbot|Googlebot|bingbot|YandexBot|DuckDuckBot|Embedly|vkShare|W3C_Validator|Iframely|skypeuripreview|nuzzel|Snapchat|Tumblr|Mediapartners-Google).*"
        }
      ]
    },
    {
      "source": "/brand/:name",
      "destination": "/api/og?type=category&brand=:name",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|WhatsApp|Twitterbot|TelegramBot|LinkedInBot|Slackbot|Discordbot|Applebot|Pinterest|redditbot|Googlebot|bingbot|YandexBot|DuckDuckBot|Embedly|vkShare|W3C_Validator|Iframely|skypeuripreview|nuzzel|Snapchat|Tumblr|Mediapartners-Google).*"
        }
      ]
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
